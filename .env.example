# Copy to .env; never commit actual credentials.
PUID=99
PGID=100
PORT=5000
CONFIG_PATH=/mnt/user/appdata/horadrictube
MEDIA_PATH=/mnt/user/media
TRANSCODE_PATH=/mnt/cache/horadrictube-transcode
API_KEY=
# Optional; ai.enabled must also be true in config.json.
TYPESAFE_API_KEY=
# Runtime tone-mapping backend. Both use libplacebo Spline; x265 stays on CPU.
TONEMAP_BACKEND=cpu
TONEMAP_THREADS=2
# Opt into Vulkan Video decoding with per-file CPU fallback. x265 remains CPU.
DECODE_BACKEND=cpu
# Vulkan device index or name substring, e.g. NVIDIA. Used for Vulkan decoding.
VULKAN_DEVICE=0
# For compose.gpu.yaml, set the render device and its owning group ID.
VULKAN_RENDER_DEVICE=/dev/dri/renderD128
# RENDER_GID=109
