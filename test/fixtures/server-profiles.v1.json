{
  "profiles": {
    "default": {
      "extension": "mkv",
      "pathMappings": [
        {
          "from": "/media/",
          "to": "/Television/"
        }
      ],
      "fileRenames": [
        {
          "regex": "( Proper)$",
          "substitution": ""
        },
        {
          "regex": "(1080p|2160p)$",
          "substitution": "1080p HEVC"
        },
        {
          "regex": "(SDTV|DVD|480p|720p)$",
          "substitution": "$& HEVC"
        },
        {
          "regex": "Remux-",
          "substitution": "Bluray-"
        }
      ],
      "delay": 0,
      "selection": {
        "audio": {
          "allowSecondary": true,
          "primary": [
            {
              "type": "audio",
              "description": "Select the first English track as primary audio",
              "rules": [
                {
                  "property": "language",
                  "operator": "==",
                  "value": "eng"
                }
              ]
            }
          ],
          "secondary": [
            {
              "type": "audio",
              "description": "Select any commentary tracks as secondary",
              "rules": [
                {
                  "property": "title",
                  "operator": "contains",
                  "value": "commentary"
                }
              ]
            }
          ]
        },
        "subtitle": {
          "allowSecondary": true,
          "primary": [
            {
              "type": "subtitle",
              "description": "Mark any forced subs as the default",
              "rules": [
                {
                  "property": "forced",
                  "operator": "==",
                  "value": true
                }
              ]
            }
          ],
          "secondary": [
            {
              "type": "subtitle",
              "description": "Include any other English subtitles",
              "rules": [
                {
                  "property": "language",
                  "operator": "==",
                  "value": "eng"
                }
              ]
            },
            {
              "type": "subtitle",
              "description": "Include any other SDH subtitles",
              "rules": [
                {
                  "property": "title",
                  "operator": "contains",
                  "value": "sdh"
                }
              ]
            }
          ]
        }
      },
      "encoder": [
        {
          "type": "video",
          "description": "Base video profile",
          "result": {
            "codec": "libx265",
            "crf": "23",
            "preset": "slow"
          }
        },
        {
          "type": "video",
          "description": "Crop remuxes",
          "rules": [
            {
              "property": "filename",
              "operator": "contains",
              "value": "Remux-"
            }
          ],
          "result": {
            "crop": true
          }
        },
        {
          "type": "video",
          "description": "Downscale to 1080p if neccesary",
          "rules": [
            {
              "property": "width",
              "operator": ">",
              "value": 1920
            }
          ],
          "result": {
            "size": "1920:-2"
          }
        },
        {
          "type": "video",
          "description": "Tonemap HDR -> SDR if neccesary",
          "rules": [
            {
              "property": "hdr",
              "operator": "==",
              "value": true
            }
          ],
          "result": {
            "tonemap": true
          }
        },
        {
          "type": "audio",
          "description": "Convert any surround sound to AC3 384k",
          "rules": [
            {
              "property": "primary",
              "operator": "==",
              "value": true
            },
            {
              "property": "channels",
              "operator": ">=",
              "value": 6
            }
          ],
          "result": {
            "codec": "eac3",
            "bitrate": "384k",
            "channels": 6
          }
        },
        {
          "type": "audio",
          "description": "Copy primary audio if it's already AC3 384k 5.1",
          "rules": [
            {
              "property": "primary",
              "operator": "==",
              "value": true
            },
            {
              "property": "codec",
              "operator": "contains",
              "value": "ac3"
            },
            {
              "property": "bitrate",
              "operator": "<=",
              "value": 384000
            },
            {
              "property": "channels",
              "operator": "==",
              "value": 6
            }
          ],
          "result": {
            "codec": "copy"
          }
        },
        {
          "type": "audio",
          "description": "Convert primary audio with anything less than 5.1 to AAC stereo",
          "rules": [
            {
              "property": "primary",
              "operator": "==",
              "value": true
            },
            {
              "property": "channels",
              "operator": "<",
              "value": 6
            }
          ],
          "result": {
            "codec": "aac",
            "bitrate": "192k",
            "channels": 2
          }
        },
        {
          "type": "audio",
          "description": "Copy primary audio if already AAC stereo",
          "rules": [
            {
              "property": "primary",
              "operator": "==",
              "value": true
            },
            {
              "property": "codec",
              "operator": "==",
              "value": "aac"
            },
            {
              "property": "channels",
              "operator": "==",
              "value": 2
            }
          ],
          "result": {
            "codec": "copy"
          }
        },
        {
          "type": "audio",
          "description": "Convert any secondary audio to low bitrate AAC",
          "rules": [
            {
              "property": "primary",
              "operator": "==",
              "value": false
            }
          ],
          "result": {
            "codec": "aac",
            "bitrate": "96k",
            "channels": 2
          }
        },
        {
          "type": "subtitle",
          "description": "Copy any subs as-is",
          "result": {
            "codec": "copy"
          }
        }
      ]
    },
